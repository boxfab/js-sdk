    "test:live": "vitest run --project live",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "boxfab": "^0.1.0-alpha.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv": "^16.6.1",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "defaults"
  ],
  "publishConfig": {
