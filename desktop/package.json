{
  "name": "@boxfab/desktop",
  "version": "0.1.0-alpha.1",
  "description": "BoxFab Desktop: a virtual Linux desktop in a BoxFab sandbox, for computer-use agents",
  "homepage": "https://boxfab.io",
  "license": "MIT",
  "author": "ContextFab, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boxfab/js-sdk.git",
    "directory": "desktop"
  },
  "bugs": "https://github.com/boxfab/js-sdk/issues",
  "keywords": [
    "boxfab",
    "computer-use",
    "desktop",
    "sandbox",
    "ai-agents",
    "agents",
    "ai",
    "vm"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "typecheck": "tsc --noEmit",
